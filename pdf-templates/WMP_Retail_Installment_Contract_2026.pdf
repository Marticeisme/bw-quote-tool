; i++\) if \(String\(arr[i]\) === val\) return true;\n    return false;\n}\nfunction set\F\(name, val\) {\n    var f = this.getField\(name\);\n    if \(f\) f.value = val;\n}\nfunction recalcFinancing\(rate, months\) {\n    var totalCP = localNum\("TotalCP"\);\n    var totalDP = Math.abs\(localNum\("TotalDP"\) || localNum\("DPAmount"\)\);\n   \ var unpaid  = localNum\("UnpaidBalance"\);\n    var tier    = localTier\(totalCP, totalDP\);\n    var fc = 0, pmt = 0;\n    if \(rate === 0 || months === 0 || unpaid === 0\) {\n        fc = 0;\n        pmt = months > 0 ? localMoney\(unpaid / months\) : 0\;\n    } else {\n        var f = localFactor\(tier, months, rate\);\n        if \(f > 0\) {\n            fc  = localMoney\(unpaid * \(f * months - 1\)\);\n            pmt = localMoney\(unpaid * f\);\n        }\n    }\n    setF.call\(this, "FCAmount", fc\)\;\n    setF.call\(this, "FCAmount_TIL", fc\);\n    setF.call\(this, "TotalPayments", localMoney\(unpaid + fc\)\);\n    setF.call\(this, "TotalPayments_TIL", localMoney\(unpaid + fc\)\);\n    setF.call\(this, "Total Sales Price", localMoney\(totalCP + fc\)\\);\n    setF.call\(this, "TotalSalesPrice_TIL", localMoney\(totalCP + fc\)\);\n    setF.call\(this, "PaymentAmount1", pmt\);\n}\nvar rate = localRateFromValue\(localNum\("Finance Charge"\)\);\nvar totalCP = localNum\("TotalCP"\);\nvar totalDP = Math.abs\(\localNum\("TotalDP"\) || localNum\("DPAmount"\)\);\nvar tier = localTier\(totalCP, totalDP\);\nvar approvedTerms = localValidTerms\(tier, rate\);\nvar months = Number\(event.value\);\nif \(approvedTerms.length > 0 && !localContains\(approvedTerms, event.v\alue\)\) {\n    event.value = approvedTerms[0];\n    months = Number\(approvedTerms[0]\);\n}\nrecalcFinancing.call\(this, rate, months\);\n)/S/JavaScript>>endobj1187 0 obj<</BBox[0.0 0.0 59.071 9.29803]/Length 63/Resources<</Font<</Helv 8 0 R>>/ProcSet[/PDF/Text]>>>>stream
